@baseUrl = http://localhost:3000

### 1. Crear materia (201)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": "Programación IV" }

### 2. Crear otra materia (201)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": "Base de Datos" }

### 3. Listar materias (200)
GET {{baseUrl}}/materias

### 4. Obtener materia por id (200)
GET {{baseUrl}}/materias/1

### 5. Modificar materia (200)
PUT {{baseUrl}}/materias/1
Content-Type: application/json

{ "nombre": "Programación IV" }

### 6. Crear repetida, distinto formato (409)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": "  programacion   iv " }

### 7. Modificar con el nombre de otra materia (409)
PUT {{baseUrl}}/materias/1
Content-Type: application/json

{ "nombre": "base de datos" }

### 8. nombre ausente (400)
POST {{baseUrl}}/materias
Content-Type: application/json

{ }

### 9. nombre no es texto (400)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": 123 }

### 10. nombre vacío (400)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": "   " }

### 11. nombre demasiado largo (400)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }

### 12. id inválido (400)
GET {{baseUrl}}/materias/abc

### 13. id en cero (400)
GET {{baseUrl}}/materias/0

### 14. id válido que no existe (404)
GET {{baseUrl}}/materias/9999

### 15. Modificar id que no existe (404)
PUT {{baseUrl}}/materias/9999
Content-Type: application/json

{ "nombre": "Inexistente" }

### 16. Eliminar id que no existe (404)
DELETE {{baseUrl}}/materias/9999

### 17. JSON mal formado (400)
POST {{baseUrl}}/materias
Content-Type: application/json

{ "nombre": 

### 18. Eliminar materia (204)
DELETE {{baseUrl}}/materias/2

