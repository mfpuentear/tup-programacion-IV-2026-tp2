@url=http://localhost:3000

### ==============================
### MATERIAS
### ==============================

###Crear materia
POST {{url}}/materias
Content-Type: application/json

{
    "Nombre": "Programacion"
}



###Crear otra materia
POST {{url}}/materias
Content-Type: application/json

{
    "Nombre": "Base de Datos"
}



###Obtener todas las materias
GET {{url}}/materias



###Obtener materia por ID
GET {{url}}/materias/1



###Intentar crear materia repetida
POST {{url}}/materias
Content-Type: application/json

{
    "Nombre": "programacion"
}



### ==============================
### CALIFICACIONES
### ==============================


###Crear una calificación
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Juan Perez",
    "Materia_Id": 1,
    "Nota_1": 8,
    "Nota_2": 7.5,
    "Nota_3": 9
}



###Crear otra calificación
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Pedro Gomez",
    "Materia_Id": 1,
    "Nota_1": 6,
    "Nota_2": 8,
    "Nota_3": 7
}



###Obtener todas las calificaciones
GET {{url}}/calificaciones



###Obtener una calificación por ID
GET {{url}}/calificaciones/1



### Intentar registrar al mismo alumno nuevamente en la misma materia
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "juan perez",
    "Materia_Id": 1,
    "Nota_1": 10,
    "Nota_2": 10,
    "Nota_3": 10
}



###Modificar una calificación
PUT {{url}}/calificaciones/1
Content-Type: application/json

{
    "Nombre_Alumno": "Juan Perez",
    "Materia_Id": 1,
    "Nota_1": 9,
    "Nota_2": 8,
    "Nota_3": 10
}



###Eliminar una calificación
DELETE {{url}}/calificaciones/1



###Nombre vacío
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "",
    "Materia_Id": 1,
    "Nota_1": 8,
    "Nota_2": 7,
    "Nota_3": 9
}



###Materia inexistente
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Carlos Lopez",
    "Materia_Id": 999,
    "Nota_1": 8,
    "Nota_2": 7,
    "Nota_3": 9
}



###Nota mayor a 10
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Carlos Lopez",
    "Materia_Id": 1,
    "Nota_1": 11,
    "Nota_2": 7,
    "Nota_3": 9
}



###Nota menor a 0
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Carlos Lopez",
    "Materia_Id": 1,
    "Nota_1": -1,
    "Nota_2": 7,
    "Nota_3": 9
}



###Falta una nota
POST {{url}}/calificaciones
Content-Type: application/json

{
    "Nombre_Alumno": "Carlos Lopez",
    "Materia_Id": 1,
    "Nota_1": 8,
    "Nota_2": 7
}



###ID inválido
GET {{url}}/calificaciones/abc