@url=http://localhost:3000

### Crear materia (id 1)
POST {{url}}/materias
Content-Type: application/json

{
  "nombre": "Historia"
}

### Crear otra materia (id 2)
POST {{url}}/materias
Content-Type: application/json

{
  "nombre": "Matemática"
}

### Ver materias
GET {{url}}/materias



### Crear registro de alumno para una materia
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Lionel Messi",
  "materia_id": 1,
  "nota1": 10,
  "nota2": 10,
  "nota3": 10
}

### Mismo alumno en otra materia (permitido)
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Lionel Messi",
  "materia_id": 2,
  "nota1": 10,
  "nota2": 10,
  "nota3": 10
}



### Otro alumno
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Fernando Alonso",
  "materia_id": 2,
  "nota1": 7,
  "nota2": 9,
  "nota3": 9
}

### Listar todos los alumnos
GET {{url}}/calificaciones



### Filtrar por materia
GET {{url}}/calificaciones?materia_id=1



### Ver registro por id
GET {{url}}/calificaciones/1



### Modificar
PUT {{url}}/calificaciones/1
Content-Type: application/json

{
  "alumno": "Franco Colapinto",
  "materia_id": 1,
  "nota1": 9,
  "nota2": 6,
  "nota3": 10
}



### Eliminar registro
DELETE {{url}}/calificaciones/3



### Cargar registro sin alumno
POST {{url}}/calificaciones
Content-Type: application/json

{
  "materia_id": 1,
  "nota1": 8,
  "nota2": 8,
  "nota3": 8
}


### Alumno con números
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Max Verstappen3",
  "materia_id": 2,
  "nota1": 9,
  "nota2": 8,
  "nota3": 8
}


### Materia inexistente
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Nico Paz",
  "materia_id": 999,
  "nota1": 8,
  "nota2": 8,
  "nota3": 8
}


### Falta una nota
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Nico Paz",
  "materia_id": 2,
  "nota1": 8,
  "nota2": 8
}


### Nota fuera de escala
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Kimi Räikkönen",
  "materia_id": 1,
  "nota1": 11,
  "nota2": -1,
  "nota3": 8
}


### Nota no numérica
POST {{url}}/calificaciones
Content-Type: application/json

{
  "alumno": "Kimi Räikkönen",
  "materia_id": 1,
  "nota1": "hola",
  "nota2": 8,
  "nota3": 8
}

### Filtro inválido
GET {{url}}/calificaciones?materia_id=hola



### Id inválido
GET {{url}}/calificaciones/hola

### Id inexistente
GET {{url}}/calificaciones/99999