### =========================
### MATERIAS
### =========================


### 1. Crear materia
POST http://localhost:3000/materias
Content-Type: application/json

{
    "nombre": "Matematica"
}


### 2. Crear otra materia
POST http://localhost:3000/materias
Content-Type: application/json

{
    "nombre": "Programacion"
}


### 3. Ver todas las materias
GET http://localhost:3000/materias


### 4. Ver una materia
GET http://localhost:3000/materias/1


### =========================
### CALIFICACIONES
### =========================


### 5. Crear calificacion
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Juan Perez",
    "materia_id": 1,
    "nota1": 8,
    "nota2": 7,
    "nota3": 9
}


### 6. Crear otra calificacion
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Maria Lopez",
    "materia_id": 1,
    "nota1": 10,
    "nota2": 9,
    "nota3": 8
}


### 7. Ver todas las calificaciones
GET http://localhost:3000/calificaciones


### 8. Ver calificacion por ID
GET http://localhost:3000/calificaciones/1


### 9. Modificar calificacion
PUT http://localhost:3000/calificaciones/1
Content-Type: application/json

{
    "alumno": "Juan Perez",
    "materia_id": 1,
    "nota1": 9,
    "nota2": 8,
    "nota3": 10
}


### 10. Eliminar calificacion
DELETE http://localhost:3000/calificaciones/1


### =========================
### PRUEBAS DE VALIDACIÓN
### =========================


### 11. Nota mayor que 10
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Pedro Gomez",
    "materia_id": 1,
    "nota1": 11,
    "nota2": 8,
    "nota3": 7
}


### 12. Nota menor que 0
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Pedro Gomez",
    "materia_id": 1,
    "nota1": -1,
    "nota2": 8,
    "nota3": 7
}


### 13. Falta una nota
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Pedro Gomez",
    "materia_id": 1,
    "nota1": 8,
    "nota2": 7
}


### 14. Materia inexistente
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Pedro Gomez",
    "materia_id": 999,
    "nota1": 8,
    "nota2": 7,
    "nota3": 9
}


### 15. Calificacion duplicada
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "Maria Lopez",
    "materia_id": 1,
    "nota1": 7,
    "nota2": 7,
    "nota3": 7
}


### 16. Alumno vacio
POST http://localhost:3000/calificaciones
Content-Type: application/json

{
    "alumno": "",
    "materia_id": 1,
    "nota1": 8,
    "nota2": 8,
    "nota3": 8
}


### 17. ID invalido
GET http://localhost:3000/calificaciones/abc